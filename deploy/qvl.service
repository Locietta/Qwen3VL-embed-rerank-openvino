[Unit]
Description=qvl: Qwen3-VL embedding and rerank service (OpenVINO, Intel iGPU)
Wants=network-online.target
After=network-online.target
ConditionPathExists=%h/.config/qvl/config.json

[Service]
Type=simple
ExecStart=%h/services/qvl/bin/current --config %h/.config/qvl/config.json
# The Intel OpenCL driver comes from the deploy tree's Pixi environment; the
# binary finds the libraries through its rpath, the ICD loader through this.
Environment=OCL_ICD_VENDORS=%h/services/qvl/src/.pixi/envs/default/etc/OpenCL/vendors
Restart=on-failure
RestartSec=10s
TimeoutStopSec=30s
NoNewPrivileges=true
UMask=0077
# GPU buffers count as shmem. Both 2B models: ~6.5 GiB stateless; the
# reranker's KV cache (prefix reuse) adds ~2.6 GiB under varied load (soak
# peak 10.5 GiB, 2026-10-12). Headroom on top.
MemoryMax=14G

[Install]
WantedBy=default.target
